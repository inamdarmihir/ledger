# Copy to .env and fill in values. Never commit .env.
#   cp .env.example .env

# Required for live OpenAI embeddings and Agents SDK triage
# (examples/agent_demo.py, ledger.embeddings.make_openai_embed_fn)
OPENAI_API_KEY=

# Optional: Agents SDK default model override.
# Ledger's triage agent sets model="gpt-5.6-sol" explicitly (docs-recommended).
# OPENAI_DEFAULT_MODEL=gpt-5.6-sol

# Optional: Qdrant URL for production semantic history
# (demos/tests use QdrantClient(location=":memory:"))
# QDRANT_URL=http://localhost:6333
